<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ : niente backup ne' trasferimento su nuovo dispositivo.
  Le preferenze contengono l'api_token di sessione: non deve finire in un backup
  cloud ne' essere clonato su un altro telefono.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
